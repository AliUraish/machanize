# Backend only. Never expose this value through Vite or commit a real credential.
GEMINI_API_KEY=

# Raspberry Pi runtime only.
MACHANIZE_RESET_TOKEN=
MACHANIZE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# module:function returning (LeRobot robot or LeRobotAdapter, local action source)
MACHANIZE_RUNTIME_FACTORY=

# Variables used by examples.so101.pi_runtime_factory:create_runtime_hardware.
MACHANIZE_FOLLOWER_PORT=/dev/ttyACM0
MACHANIZE_FRONT_CAMERA=/dev/video0
MACHANIZE_WRIST_CAMERA=/dev/video2
MACHANIZE_CONTROL_FPS=30
MACHANIZE_ACT_CHECKPOINT=
MACHANIZE_ACT_DEVICE=cpu
